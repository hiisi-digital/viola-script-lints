{
  "name": "@hiisi/viola-script-lints",
  "version": "0.3.1",
  "description": "Run shell scripts as custom lints for Viola.",
  "exports": "./mod.ts",
  "publish": {
    "include": [
      "mod.ts",
      "src/**/*.ts",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "src/**/*_test.ts",
      "tests/**"
    ]
  },
  "imports": {
    "@hiisi/viola": "jsr:@hiisi/viola@^0.3.0",
    "@hiisi/viola/linters": "jsr:@hiisi/viola@^0.3.0/linters",
    "@std/path": "jsr:@std/path@^1",
    "@std/fs": "jsr:@std/fs@^1",
    "@std/assert": "jsr:@std/assert@^1"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-run --allow-write --allow-env --no-check",
    "check": "deno check mod.ts",
    "lint": "deno run -A --min-dep-age=0 jsr:@hiisi/viola-cli@^0.3.1 --project . --include ."
  },
  "test": {
    "include": [
      "tests/"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false
  },
  "minimumDependencyAge": 0
}
