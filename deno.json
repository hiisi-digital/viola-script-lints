{
  "name": "@hiisi/viola-script-lints",
  "version": "0.4.0",
  "description": "Run shell scripts as custom lints for Viola.",
  "exports": "./mod.ts",
  "publish": {
    "include": [
      "mod.ts",
      "src/**/*.ts",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "src/**/*_test.ts",
      "tests/**"
    ]
  },
  "imports": {
    "@hiisi/viola": "jsr:@hiisi/viola@^0.4.0",
    "@hiisi/viola/linters": "jsr:@hiisi/viola@^0.4.0/linters",
    "@std/path": "jsr:@std/path@^1",
    "@std/fs": "jsr:@std/fs@^1",
    "@std/assert": "jsr:@std/assert@^1",
    "@hiisi/viola-default-lints": "jsr:@hiisi/viola-default-lints@^0.4.0",
    "@hiisi/viola-grammar-ts": "jsr:@hiisi/viola-grammar-ts@^0.4.0"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-run --allow-write --allow-env --no-check",
    "check": "deno check mod.ts",
    "lint": "deno run -A gate.ts"
  },
  "test": {
    "include": [
      "tests/"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false
  },
  "minimumDependencyAge": 0,
  "links": [
    "../viola",
    "../viola-default-lints",
    "../viola-grammar-ts"
  ]
}
